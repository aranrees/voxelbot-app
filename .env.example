# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Moonshot (Kimi) Configuration
MOONSHOT_API_KEY=sk-Twk9nQhv4AJEZWCIvcg2fGkQNuBbgybcyKgzWKq8bBIvr523

# AI Provider Selection
# Options: "openai" or "moonshot"
AI_PROVIDER=openai

# AI Model Selection
# For OpenAI: "gpt-4o", "gpt-4o-mini", "gpt-4-turbo"
# For Moonshot: "kimi-k2.5", "kimi-latest", "kimi-k2-thinking", "kimi-k2-turbo-preview"
AI_MODEL=gpt-4o

# Quick Switch Examples:
# To use Kimi K2.5: Set AI_PROVIDER=moonshot and AI_MODEL=kimi-k2.5
# To use Kimi K2 Turbo (faster): Set AI_PROVIDER=moonshot and AI_MODEL=kimi-k2-turbo-preview
# To use GPT-4o: Set AI_PROVIDER=openai and AI_MODEL=gpt-4o
# To use GPT-4o-mini (cheaper): Set AI_PROVIDER=openai and AI_MODEL=gpt-4o-mini

